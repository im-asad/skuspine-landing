# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Purelymail mailbox the website sends demo form submissions from.
# Use an app password for this mailbox, never the real login password.
SMTP_USER=website@skuspine.com
SMTP_PASSWORD=

# Purelymail's outgoing server. Port 465 uses SSL/TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465

# Where submissions are delivered (comma-separated for several addresses).
DEMO_REQUEST_TO=getintouch@skuspine.com

# Optional display name and sender. Defaults to "skuspine website <SMTP_USER>".
# DEMO_REQUEST_FROM=skuspine website <website@skuspine.com>
